        {
          "info": {
            "name": "Import an app to an existing app (Business / Enterprise only)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://budibase.app/api/public/v1/applications/:id/import",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "appExport",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Import an app to an existing app (Business / Enterprise only)"
        }
